{
  "name": "retainerproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:worker": "npm run build && wrangler dev --test-scheduled",
    "build": "vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "deploy": "npm run build:production && wrangler deploy",
    "deploy:dry-run": "npm run build:production && wrangler deploy --dry-run",
    "db:local": "wrangler d1 migrations apply retainerproof-local --local",
    "db:remote": "wrangler d1 migrations apply retainerproof-production --remote",
    "types:bindings": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run db:local && playwright test",
    "sample:pdf": "vite-node scripts/generate-sample-reports.ts",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build && npm run deploy:dry-run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.3.27",
    "better-auth": "^1.3.27",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "stripe": "^22.3.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.7",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  }
}
